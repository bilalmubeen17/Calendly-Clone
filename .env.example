# Google OAuth credentials — from Google Cloud Console (see README.md)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Must exactly match a redirect URI registered in Google Cloud Console.
# For local dev:
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Base URL of your deployed app (no trailing slash). Used to build booking links.
APP_URL=http://localhost:3000

# A random long string, used to sign a lightweight session cookie for the dashboard.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=replace-this-with-a-random-string
